; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bally Battle"
run/main_scene="uid://dbndtnlawjm5v"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/image="uid://cwe1fhhy0bn7p"
config/icon="uid://cb4a58eh42j2s"

[autoload]

PlayerData="*uid://cf8v0s3o25aw"
Music="*uid://bnsm0k2vnw4cf"
NetworkManager="*res://Scripts/NetworkManager.gd"
Background="*res://Areas/GameBackground.tscn"
DebugHUD="*res://Scripts/DebugHUD.gd"
MobileControls="*res://UI/MobileControls.tscn"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mobile/always_show_controls=false

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[gui]

theme/custom="res://Theme/GameTheme.tres"

